{
  "name": "dsh-ask-aside",
  "version": "0.3.0",
  "description": "划词提问：选中正文里看不懂的术语 → 右侧栏独立会话里追问，不打断主对话；默认 fork 主会话承接全部上下文，也可切「只看引文」。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sidebar",
    "ask",
    "selection"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.0",
    "node": ">=20"
  }
}
